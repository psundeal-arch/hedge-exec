[Unit]
Description=hedge-bot watch（两腿对齐报警 + 模拟盘记资金费）
After=network-online.target
Wants=network-online.target
OnFailure=hedge-bot-failed.service

[Service]
Type=oneshot
WorkingDirectory=%h/hedge-bot
# perp-track 已并入本仓库，两边共用这一份 .env（通知凭据 + 只读 key）
EnvironmentFile=%h/hedge-bot/.env
ExecStart=%h/hedge-bot/.venv/bin/hedge watch
TimeoutStartSec=300
