[Unit]
Description=hedge exec worker（日内执行算法：你定量，程序在时间窗内挑时机分批做完）
After=network-online.target
Wants=network-online.target
OnFailure=hedge-bot-failed@%n.service
# 崩溃重启有上限（审查 M18）：30 分钟内失败 5 次就进 failed、触发传呼，不再每 60 秒无限重启
StartLimitIntervalSec=1800
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/hedge-bot
# 只读 key + 通知凭据来自 ~/vault（不加 -：缺了就起不来，不静默）。交易 key 不在这里，
# worker 从 HEDGE_EXEC_KEYS 读，默认 ~/perp-grid-live/.env.trade（服务器 IP 绑定的 Coinbase View+Trade key）
EnvironmentFile=%h/vault/coinbase-view.env
EnvironmentFile=%h/vault/notify.env
ExecStart=%h/hedge-bot/.venv/bin/hedge exec worker
# SIGTERM 后排程器停在安全点；正在做的对冲子单（Ladder）最多几分钟，给够时间收尾。被强杀也没关系：重启后恢复流程会撤旧单、补对冲缺口
KillSignal=SIGTERM
TimeoutStopSec=330
Restart=on-failure
RestartSec=60
# 这个单元能读到交易 key：最小化它能做的事（审查 M18）。ProtectSystem 之类要用户命名空间，
# 在 user 单元里有起不来的风险 —— exec 起不来的代价比这点加固大，故不加
NoNewPrivileges=yes
UMask=0077
MemoryMax=1G

[Install]
WantedBy=default.target
