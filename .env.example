# 本机用：复制成 .env 并 chmod 600。服务器上不用这个文件 —— 凭据在 ~/vault（见 README）。
# 这里只放【只读】key + 通知凭据。交易 key 放 .env.trade（只在本机，不进仓库、不上服务器）。

# Kraken：Settings → API → 只勾 Query Funds
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Coinbase CDP key：只给 View（can_trade=false）。perp-track 用同一把
COINBASE_API_KEY_NAME=
COINBASE_API_PRIVATE_KEY=

# Robinhood Crypto Trading API：用 `hedge rh-keygen` 生成，私钥自动写入，
# 公钥贴到 Robinhood 网页；权限只勾 Read crypto holdings
RH_API_KEY=
RH_PRIVATE_KEY=

# 通知（审查 M17：原来漏了这几项 —— 照模板配的人告警会静默失效）
# Pushover：保证金 / 对齐 / 执行的传呼都走它（priority 2 穿透勿扰）
PUSHOVER_TOKEN=
PUSHOVER_USER=
# Discord webhook：普通通知与降级通道
DISCORD_WEBHOOK_URL=
# 邮件（perp-track 日报）
SMTP_USER=
SMTP_PASSWORD=
